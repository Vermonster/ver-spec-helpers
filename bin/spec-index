#!/usr/bin/env bash
# spec-index — manage the spec library index
# Usage: spec-index <command> [<specs-dir>]
set -eu

# ── helpers ──────────────────────────────────────────────────────────────────

usage() {
  cat <<EOF
spec-index — manage the spec library context index

Commands:
  build [<specs-dir>]              Parse all spec files and write index.yaml
  check [<specs-dir>]              Exit 1 if index is missing or stale (for CI / pre-commit)
  list  [<specs-dir>]              Print id, domain, and summary for each spec
  stats [<specs-dir>]              Show token budget and domain breakdown

  rag-build  [<specs-dir>]         Chunk + embed specs; write chunks.jsonl and embeddings.npy
  rag-search <query> [<specs-dir>] Semantic search; prints JSON array of top matches to stdout
  rag-check  [<specs-dir>]         Exit 1 if RAG index is missing or stale

<specs-dir> is auto-detected if omitted (looks for openspec/specs/ then specs/).
RAG commands require Python 3 and: pip install -r rag/requirements.txt
EOF
}

detect_specs_dir() {
  if [ -d "openspec/specs" ] && find "openspec/specs" -maxdepth 3 -name "spec.md" | grep -q .; then
    printf '%s\n' "openspec/specs"
  elif [ -d "specs" ] && find "specs" -maxdepth 3 -name "spec.md" | grep -q .; then
    printf '%s\n' "specs"
  else
    printf '%s\n' ""
  fi
}

require_specs_dir() {
  _dir="${1:-}"
  if [ -z "$_dir" ]; then
    _dir=$(detect_specs_dir)
  fi
  if [ -z "$_dir" ]; then
    printf 'error: could not find a specs directory.\n' >&2
    printf '       Pass one explicitly: spec-index %s <specs-dir>\n' "$COMMAND" >&2
    exit 1
  fi
  if [ ! -d "$_dir" ]; then
    printf 'error: directory not found: %s\n' "$_dir" >&2
    exit 1
  fi
  printf '%s\n' "$_dir"
}

# Strip common markdown inline formatting so summaries are plain text.
strip_markdown() {
  sed \
    -e 's/`//g' \
    -e 's/\*\*//g' \
    -e 's/\*//g' \
    -e 's/\[[^]]*\]([^)]*)//g' \
    -e 's/"/'\''/g'
}

# Count lines from stdin; portable across BSDs and GNU.
count_lines() { awk 'END { print NR }'; }

# ── rag helpers ──────────────────────────────────────────────────────────────

# Locate the rag/ Python scripts relative to this script's own directory.
# Supports two layouts:
#   source repo:    bin/spec-index  +  rag/build.py  (scripts one level up)
#   flat install:   bin/spec-index  +  bin/rag/build.py
find_rag_script() {
  _name="$1"   # e.g. "build.py"
  _self=$(cd "$(dirname "$0")" && pwd)

  # source-repo layout: bin/ and rag/ are siblings under the project root
  if [ -f "$_self/../rag/$_name" ]; then
    printf '%s\n' "$_self/../rag/$_name"
    return
  fi

  # flat install: rag/ lives inside bin/
  if [ -f "$_self/rag/$_name" ]; then
    printf '%s\n' "$_self/rag/$_name"
    return
  fi

  printf 'error: %s not found\n' "$_name" >&2
  printf '       Install RAG scripts — see README for instructions.\n' >&2
  exit 1
}

require_python() {
  if command -v python3 >/dev/null 2>&1; then
    printf 'python3\n'
  elif command -v python >/dev/null 2>&1; then
    printf 'python\n'
  else
    printf 'error: python3 not found\n' >&2
    exit 1
  fi
}

# ── commands ─────────────────────────────────────────────────────────────────

cmd_build() {
  specs_dir=$(require_specs_dir "${1:-}")

  index_file="$specs_dir/index.yaml"
  timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')

  spec_files=$(find "$specs_dir" -name "spec.md" | sort)

  if [ -z "$spec_files" ]; then
    printf 'error: no spec.md files found in %s\n' "$specs_dir" >&2
    exit 1
  fi

  # Write to a temp file first, then atomically replace
  tmp_file=$(mktemp)
  trap 'rm -f "$tmp_file"' EXIT INT TERM

  {
    printf '# Auto-generated by spec-index. Do not edit manually.\n'
    printf 'generated_at: %s\n' "$timestamp"
    printf 'specs_dir: %s\n' "$specs_dir"
    printf 'specs:\n'

    count=0
    while IFS= read -r spec_file; do
      [ -z "$spec_file" ] && continue

      id=$(basename "$(dirname "$spec_file")")

      # Domain: first hyphen-delimited word of the spec id.
      domain=$(printf '%s\n' "$id" | cut -d'-' -f1)

      # Summary: two formats are supported.
      # Format A (OpenSpec): first non-blank text between # Title and first ---
      # Format B (Spec Kit): "# Feature Specification: NAME" — extract name
      #                      and append first plain-text sentence from User Story 1
      if grep -q '^# Feature Specification:' "$spec_file" 2>/dev/null; then
        feature_name=$(awk '/^# Feature Specification:/ {
          sub(/^# Feature Specification:[ ]*/, ""); print; exit
        }' "$spec_file")
        story_text=$(awk '
          /^### User Story 1/ { found=1; next }
          found && /^\*\*/ { next }
          found && /^[A-Za-z]/ && NF { print; exit }
        ' "$spec_file")
        if [ -n "$story_text" ]; then
          summary=$(printf '%s — %s' "$feature_name" "$story_text" \
            | strip_markdown | tr -s ' ' | awk '{print substr($0,1,200)}')
        else
          summary=$(printf '%s' "$feature_name" \
            | strip_markdown | tr -s ' ' | awk '{print substr($0,1,200)}')
        fi
      else
        summary=$(awk '
          /^# /    { found=1; next }
          found && /^---/ { exit }
          found && /^#/   { exit }
          found && NF     { print; exit }
        ' "$spec_file" | strip_markdown | tr -s ' ' | sed 's/^[[:space:]]*//' | awk '{print substr($0,1,200)}')
      fi
      # Token estimate: file size in bytes / 4, rounded to nearest 10.
      chars=$(wc -c < "$spec_file" | awk '{print $1}')
      tokens=$(( ((chars / 4) + 5) / 10 * 10 ))

      # Paths: backtick-quoted tokens containing /, excluding HTTP URLs,
      # absolute paths, and glob/query patterns.
      paths=$(grep -o '`[^`]*/[^`]*`' "$spec_file" 2>/dev/null \
        | tr -d '`' \
        | grep -v '^http' \
        | grep -v '^/' \
        | grep -v '[?=*]' \
        | sort -u \
        || true)

      printf '  - id: %s\n' "$id"
      printf '    domain: %s\n' "$domain"
      printf '    summary: "%s"\n' "$summary"
      printf '    token_estimate: %s\n' "$tokens"

      if [ -n "$paths" ]; then
        printf '    paths:\n'
        printf '%s\n' "$paths" | while IFS= read -r p; do
          [ -n "$p" ] && printf '      - %s\n' "$p"
        done
      else
        printf '    paths: []\n'
      fi

      count=$((count + 1))
    done <<< "$spec_files"

  } > "$tmp_file"

  mv "$tmp_file" "$index_file"
  trap - EXIT INT TERM

  printf 'built %s (%s specs)\n' "$index_file" "$count"
}

cmd_check() {
  specs_dir=$(require_specs_dir "${1:-}")

  index_file="$specs_dir/index.yaml"

  if [ ! -f "$index_file" ]; then
    printf 'stale: index.yaml does not exist (run: spec-index build %s)\n' "$specs_dir" >&2
    exit 1
  fi

  # Any spec.md newer than the index?
  newer=$(find "$specs_dir" -name "spec.md" -newer "$index_file" | count_lines)
  if [ "$newer" -gt 0 ]; then
    printf 'stale: %s spec file(s) modified after index was built (run: spec-index build %s)\n' \
      "$newer" "$specs_dir" >&2
    exit 1
  fi

  # Count mismatch?
  spec_count=$(find "$specs_dir" -name "spec.md" | count_lines)
  index_count=$(grep -c "^  - id:" "$index_file" 2>/dev/null || printf '0\n')

  if [ "$spec_count" != "$index_count" ]; then
    printf 'stale: %s spec files but %s index entries (run: spec-index build %s)\n' \
      "$spec_count" "$index_count" "$specs_dir" >&2
    exit 1
  fi

  printf 'ok: index is current (%s specs)\n' "$index_count"
}

cmd_list() {
  specs_dir=$(require_specs_dir "${1:-}")

  index_file="$specs_dir/index.yaml"
  if [ ! -f "$index_file" ]; then
    printf 'error: index.yaml not found — run: spec-index build %s\n' "$specs_dir" >&2
    exit 1
  fi

  awk '
    /^  - id:/      { id=$3 }
    /^    domain:/  { domain=$2 }
    /^    summary:/ {
      sub(/^    summary: /, "")
      gsub(/^"/, ""); gsub(/"$/, "")
      printf "%-40s %-16s %s\n", id, domain, $0
    }
  ' "$index_file"
}

cmd_stats() {
  specs_dir=$(require_specs_dir "${1:-}")

  index_file="$specs_dir/index.yaml"
  if [ ! -f "$index_file" ]; then
    printf 'error: index.yaml not found — run: spec-index build %s\n' "$specs_dir" >&2
    exit 1
  fi

  total_specs=$(grep -c "^  - id:" "$index_file" 2>/dev/null || printf '0\n')
  total_tokens=$(awk '/token_estimate:/ { sum += $2 } END { print sum+0 }' "$index_file")

  printf 'specs:        %s\n' "$total_specs"
  printf 'tokens (est): ~%s\n' "$total_tokens"
  printf '\n'

  printf 'by domain:\n'
  awk '/^    domain:/ { print $2 }' "$index_file" \
    | sort | uniq -c | sort -rn \
    | awk '{ printf "  %-20s %s specs\n", $2, $1 }'

  printf '\n'
  printf 'largest specs:\n'
  awk '
    /^  - id:/             { id=$3 }
    /^    token_estimate:/ { print $2, id }
  ' "$index_file" \
    | sort -rn \
    | awk 'NR<=5 { printf "  %-40s ~%s tokens\n", $2, $1 }'
}

cmd_rag_build() {
  specs_dir=$(require_specs_dir "${1:-}")
  py=$(require_python)
  script=$(find_rag_script "build.py")
  exec "$py" "$script" "$specs_dir"
}

cmd_rag_search() {
  # Usage: spec-index rag-search <query> [<specs-dir>]
  if [ -z "${1:-}" ]; then
    printf 'usage: spec-index rag-search <query> [<specs-dir>]\n' >&2
    exit 1
  fi
  query="$1"
  shift
  specs_dir=$(require_specs_dir "${1:-}")
  py=$(require_python)
  script=$(find_rag_script "search.py")
  exec "$py" "$script" "$specs_dir" "$query"
}

cmd_rag_check() {
  specs_dir=$(require_specs_dir "${1:-}")
  manifest="$specs_dir/rag/manifest.json"

  if [ ! -f "$manifest" ]; then
    printf 'stale: RAG index does not exist (run: spec-index rag-build %s)\n' "$specs_dir" >&2
    exit 1
  fi

  # Any spec.md newer than the manifest?
  newer=$(find "$specs_dir" -name "spec.md" -newer "$manifest" | count_lines)
  if [ "$newer" -gt 0 ]; then
    printf 'stale: %s spec file(s) modified after RAG index was built (run: spec-index rag-build %s)\n' \
      "$newer" "$specs_dir" >&2
    exit 1
  fi

  # Spec count in manifest vs actual spec files
  actual=$(find "$specs_dir" -name "spec.md" | count_lines)
  indexed=$(grep -o '"spec_count": *[0-9]*' "$manifest" | grep -o '[0-9]*' || printf '0')
  if [ "$actual" != "$indexed" ]; then
    printf 'stale: %s spec files but manifest records %s (run: spec-index rag-build %s)\n' \
      "$actual" "$indexed" "$specs_dir" >&2
    exit 1
  fi

  chunk_count=$(grep -o '"chunk_count": *[0-9]*' "$manifest" | grep -o '[0-9]*' || printf '0')
  printf 'ok: RAG index is current (%s specs, %s chunks)\n' "$indexed" "$chunk_count"
}

# ── dispatch ─────────────────────────────────────────────────────────────────

COMMAND="${1:-}"
shift 2>/dev/null || true

case "$COMMAND" in
  build)      cmd_build      "$@" ;;
  check)      cmd_check      "$@" ;;
  list)       cmd_list       "$@" ;;
  stats)      cmd_stats      "$@" ;;
  rag-build)  cmd_rag_build  "$@" ;;
  rag-search) cmd_rag_search "$@" ;;
  rag-check)  cmd_rag_check  "$@" ;;
  help|--help|-h|"") usage ;;
  *) printf 'error: unknown command: %s\n\n' "$COMMAND" >&2; usage; exit 1 ;;
esac
